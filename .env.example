# Copy to .env and export before running (or use `env $(cat .env | xargs)`).

# SQLite by default; point at Postgres for a real deployment.
BANKASSIST_DATABASE_URL=sqlite:///bankassist.db

# Optional — without a key the assistant runs in extractive fallback mode
# (verbatim knowledge-base excerpts, still fully functional for demos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public base URL of this service (used to register Telegram webhooks).
APP_BASE_URL=http://localhost:8100

# Structured JSON logging level.
BANKASSIST_LOG_LEVEL=INFO

# /chat rate limits (messages per minute; <=0 disables).
BANKASSIST_CHAT_RATE_PER_IP=60
BANKASSIST_CHAT_RATE_PER_CONVERSATION=20

# FAILED admin auth attempts per minute, per (tenant, client IP). Successful
# calls are never counted — an operator working a busy handoff queue must not
# be throttled out of their own console. <=0 disables.
BANKASSIST_ADMIN_AUTH_FAILURES_PER_IP=10
