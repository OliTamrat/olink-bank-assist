# Copy to .env and export before running (or use `env $(cat .env | xargs)`).

# SQLite by default; point at Postgres for a real deployment.
BANKASSIST_DATABASE_URL=sqlite:///bankassist.db

# Optional — without a key the assistant runs in extractive fallback mode
# (verbatim knowledge-base excerpts, still fully functional for demos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public base URL of this service (used to register Telegram webhooks).
APP_BASE_URL=http://localhost:8100
